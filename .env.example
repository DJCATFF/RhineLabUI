# APEX 环境变量示例 —— 复制为 .env 后按本机情况修改
# .env 永远不能提交到 GitHub（.gitignore 已忽略）

NODE_ENV=development
# 开发页面自动开启文档面板。生产构建仅在配置同源 /api 网关后启用。
VITE_APEX_ENABLED=false

APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# PostgreSQL + pgvector（Docker）
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apex
DATABASE_URL=postgresql://apex:change-me@localhost:5432/apex

# Redis（BullMQ：上传处理 / 文档转换 / AI / 索引 / OCR 任务队列）
REDIS_URL=redis://localhost:6379

# MinIO（S3 兼容对象存储：原始 PDF/DOCX/PPTX/XLSX/图片/生成文件/缩略图）
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=apex
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=apex-documents

# JWT
JWT_SECRET=change-this-secret

# Apache Tika（文档文本抽取）
TIKA_URL=http://localhost:9998
