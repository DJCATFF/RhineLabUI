datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Document {
  id        String   @id @default(cuid())
  archiveNumber Int @unique @default(autoincrement())
  title     String
  fileName  String
  mimeType  String
  size      Int
  objectKey String   @unique
  sha256    String
  status    String   @default("uploaded")
  queuedAt  DateTime?
  text      String?  @db.Text
  extractionError String?
  extractionAttempts Int @default(0)
  extractedAt DateTime?
  summary   String?  @db.Text
  keyPoints String[] @default([])
  tags      String[] @default([])
  category  String?
  enrichedAt DateTime?
  enrichmentError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
  @@index([queuedAt, createdAt])
}
